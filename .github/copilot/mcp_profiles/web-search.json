{
  "name": "web-search",
  "description": "Enables web search capabilities using Brave Search API",
  "requirements": {
    "secrets": ["BRAVE_API_KEY"]
  },
  "mcpServers": {
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    }
  }
}
